{
  "mcpServers": {
    "jarvis-skills": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--manifest-path",
        "rust-mcp-server/Cargo.toml",
        "--",
        "--stdio"
      ]
    },
    "spotify": {
      "command": "node",
      "args": [
        "../spotify-mcp-server/build/index.js"
      ]
    }
  }
}
